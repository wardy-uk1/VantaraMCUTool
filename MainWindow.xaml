
<Window x:Class="VantaraMCUTool.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Vantara MCU Tool"
        Height="800" Width="1180"
        MinHeight="680" MinWidth="960"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBackground}"
        Foreground="{DynamicResource MainForeground}">

    <Window.Resources>
        <SolidColorBrush x:Key="WindowBackground" Color="#10151C"/>
        <SolidColorBrush x:Key="MainForeground" Color="#E8EDF4"/>
        <SolidColorBrush x:Key="ButtonBackground" Color="#263443"/>
        <SolidColorBrush x:Key="ButtonForeground" Color="#F0F5FA"/>
        <SolidColorBrush x:Key="InsetBackground" Color="#10151C"/>
        <SolidColorBrush x:Key="LogForeground" Color="#C6D4E3"/>
        <SolidColorBrush x:Key="NavHeading" Color="#8FA1B5"/>
        <SolidColorBrush x:Key="ActiveBackground" Color="#245748"/>
        <SolidColorBrush x:Key="Warning" Color="#E6B86A"/>
        <SolidColorBrush x:Key="Panel" Color="#1A222D"/>
        <SolidColorBrush x:Key="Muted" Color="#9AA9BB"/>
        <SolidColorBrush x:Key="Accent" Color="#59C3A5"/>

        <Style TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource ButtonBackground}"/>
            <Setter Property="Foreground" Value="{DynamicResource ButtonForeground}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="13,10"/>
            <Setter Property="Margin" Value="0,4,0,4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
        </Style>

        <Style TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
    </Window.Resources>

    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Application heading -->
        <Grid Grid.Row="0" Margin="0,0,0,20">
            <StackPanel>
                <TextBlock Text="VANTARA"
                           Foreground="{DynamicResource Accent}"
                           FontSize="13"
                           FontWeight="Bold"/>
                <TextBlock Text="MCU Tool"
                           FontSize="30"
                           FontWeight="SemiBold"
                           Margin="0,4,0,0"/>
                <TextBlock Text="ROG Xbox Ally | Diagnostics and firmware analysis"
                           Foreground="{DynamicResource Muted}"
                           FontSize="14"
                           Margin="0,5,0,0"/>
            </StackPanel>

            <Button Content="Switch to light mode"
                    Click="ToggleTheme_Click"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Width="175"/>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Navigation -->
            <Border Grid.Column="0"
                    Background="{DynamicResource Panel}"
                    CornerRadius="12"
                    Padding="14"
                    Margin="0,0,18,0">
                <StackPanel>
                    <TextBlock Text="WORKSPACE"
                               Foreground="{DynamicResource NavHeading}"
                               FontSize="11"
                               FontWeight="Bold"
                               Margin="0,0,0,12"/>

                    <Button Content="Overview"
                            IsEnabled="False"
                            Background="{DynamicResource ActiveBackground}"/>

                    <Button Content="Device diagnostics"
                            Click="RefreshSystem_Click"/>

                    <Button Content="Firmware inspection"
                            Click="InspectFirmware_Click"/>

                    <Button Content="ASUS updater logs"
                            Click="OpenLog_Click"/>

                    <Border Background="{DynamicResource InsetBackground}"
                            CornerRadius="8"
                            Padding="12"
                            Margin="0,22,0,0">
                        <StackPanel>
                            <TextBlock Text="FIRMWARE WRITING"
                                       Foreground="{DynamicResource Warning}"
                                       FontWeight="Bold"
                                       FontSize="12"/>
                            <TextBlock Text="Disabled in this version."
                                       Foreground="{DynamicResource Muted}"
                                       Margin="0,6,0,0"/>
                            <TextBlock Text="Device compatibility and recovery requirements must be verified before any future update feature."
                                       Foreground="{DynamicResource Muted}"
                                       FontSize="12"
                                       Margin="0,5,0,0"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!-- Main content -->
            <ScrollViewer Grid.Column="1"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <TextBlock Text="Overview"
                               FontSize="22"
                               FontWeight="SemiBold"
                               Margin="0,0,0,5"/>

                    <TextBlock Text="Local diagnostics, device identity and firmware inspection."
                               Foreground="{DynamicResource Muted}"
                               Margin="0,0,0,18"/>

                    <!-- Summary cards -->
                    <UniformGrid Columns="3" Margin="0,0,0,14">
                        <Border Background="{DynamicResource Panel}"
                                CornerRadius="10"
                                Padding="12"
                                Margin="0,0,5,0">
                            <StackPanel>
                                <TextBlock Text="OPERATING SYSTEM"
                                           Foreground="{DynamicResource Muted}"
                                           FontSize="11"/>
                                <TextBlock x:Name="OsValue"
                                           Text="Not checked"
                                           FontSize="18"
                                           FontWeight="SemiBold"
                                           Margin="0,8,0,0"/>
                                <TextBlock Text="Windows version"
                                           Foreground="{DynamicResource Muted}"
                                           FontSize="12"
                                           Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Background="{DynamicResource Panel}"
                                CornerRadius="10"
                                Padding="12"
                                Margin="5,0">
                            <StackPanel>
                                <TextBlock Text="BIOS VERSION"
                                           Foreground="{DynamicResource Muted}"
                                           FontSize="11"/>
                                <TextBlock x:Name="BiosValue"
                                           Text="Not queried"
                                           FontSize="18"
                                           FontWeight="SemiBold"
                                           Margin="0,8,0,0"/>
                                <TextBlock Text="Source: Windows BIOS inventory"
                                           Foreground="{DynamicResource Muted}"
                                           FontSize="12"
                                           Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Background="{DynamicResource Panel}"
                                CornerRadius="10"
                                Padding="12"
                                Margin="5,0,0,0">
                            <StackPanel>
                                <TextBlock Text="MCU FIRMWARE"
                                           Foreground="{DynamicResource Muted}"
                                           FontSize="11"/>
                                <TextBlock x:Name="McuVersionValue"
                                           Text="Not queried"
                                           FontSize="16"
                                           FontWeight="SemiBold"
                                           Margin="0,8,0,0"/>
                                <TextBlock x:Name="McuStatusValue"
                                           Text="Not queried"
                                           Foreground="{DynamicResource Muted}"
                                           FontSize="12"
                                           Margin="0,4,0,0"/>
                                <Button Content="Read MCU version"
                                        Click="ReadMcuVersion_Click"
                                        HorizontalAlignment="Stretch"
                                        Margin="0,8,0,0"
                                        Padding="8,6"/>
                            </StackPanel>
                        </Border>
                    </UniformGrid>

                    <!-- Device information -->
                    <Border Background="{DynamicResource Panel}"
                            CornerRadius="10"
                            Padding="16"
                            Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="Device information"
                                       FontSize="17"
                                       FontWeight="SemiBold"/>

                            <TextBlock Text="Values are collected locally. Windows-reported identifiers are not automatically proof of device authenticity."
                                       Foreground="{DynamicResource Muted}"
                                       FontSize="12"
                                       Margin="0,5,0,12"/>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="170"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0"
                                           Text="Device name"
                                           Margin="0,7,8,7"/>
                                <TextBlock x:Name="DeviceNameValue"
                                           Grid.Row="0"
                                           Grid.Column="1"
                                           Text="Not queried"
                                           Margin="0,7"/>

                                <TextBlock Grid.Row="1"
                                           Text="Model"
                                           Margin="0,7,8,7"/>
                                <TextBlock x:Name="ModelValue"
                                           Grid.Row="1"
                                           Grid.Column="1"
                                           Text="Not queried"
                                           Margin="0,7"/>

                                <TextBlock Grid.Row="2"
                                           Text="Serial number"
                                           Margin="0,7,8,7"/>
                                <TextBlock x:Name="SerialValue"
                                           Grid.Row="2"
                                           Grid.Column="1"
                                           Text="Not queried"
                                           Margin="0,7"/>

                                <TextBlock Grid.Row="3"
                                           Text="Product identifier"
                                           Margin="0,7,8,7"/>
                                <TextBlock x:Name="HardwareIdValue"
                                           Grid.Row="3"
                                           Grid.Column="1"
                                           Text="Not queried"
                                           Margin="0,7"/>
                            </Grid>

                            <TextBlock Text="Source: Windows system inventory (CIM). A retrieved value is not independently authenticated."
                                       Foreground="{DynamicResource Muted}"
                                       FontSize="12"
                                       Margin="0,8,0,8"/>

                            <StackPanel Orientation="Horizontal">
                                <Button Content="Refresh system information"
                                        Click="RefreshSystem_Click"/>
                                <Button Content="Copy device information"
                                        Click="CopyDeviceInformation_Click"
                                        Margin="8,4,0,4"/>
                            </StackPanel>

                            <TextBlock x:Name="DeviceDetails"
                                       Text="Select Refresh system information to collect local system details."
                                       Foreground="{DynamicResource Muted}"
                                       Margin="0,8,0,0"
                                       LineHeight="22"/>
                        </StackPanel>
                    </Border>

                    <!-- ASUS detection -->
                    <Border Background="{DynamicResource Panel}"
                            CornerRadius="10"
                            Padding="16"
                            Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="ASUS device detection"
                                       FontSize="17"
                                       FontWeight="SemiBold"/>

                            <TextBlock Text="Checks Windows Plug and Play inventory. This check does not independently authenticate the device or query MCU firmware."
                                       Foreground="{DynamicResource Muted}"
                                       FontSize="12"
                                       Margin="0,5,0,12"/>

                            <TextBlock Text="OVERALL STATUS"
                                       FontSize="11"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource Muted}"
                                       Margin="0,0,0,6"/>

                            <TextBlock x:Name="AsusOverallStatus"
                                       Text="Overall status: Not checked"
                                       FontSize="16"
                                       FontWeight="SemiBold"
                                       Margin="0,0,0,10"/>

                            <TextBlock x:Name="AsusMainStatus"
                                       Text="ASUS device: Not checked"
                                       Margin="0,0,0,5"/>

                            <TextBlock x:Name="AsusInterfaceStatus"
                                       Text="Firmware-update interface: Not checked"
                                       Margin="0,0,0,5"/>

                            <TextBlock x:Name="AsusWindowsStatus"
                                       Text="Windows device status: Not checked"
                                       Margin="0,0,0,10"/>

                            <Button Content="Detect ASUS device (read-only)"
                                    Click="DetectAsusDevice_Click"
                                    HorizontalAlignment="Left"/>

                            <TextBlock x:Name="AsusDeviceDetails"
                                       Text="ASUS device detection has not been run."
                                       Foreground="{DynamicResource Muted}"
                                       Margin="0,8,0,0"
                                       LineHeight="22"/>

                            <Button Content="Copy detection results"
                                    Click="CopyAsusDeviceDetails_Click"
                                    HorizontalAlignment="Left"
                                    Margin="0,8,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Firmware inspection -->
                    <Border Background="{DynamicResource Panel}"
                            CornerRadius="10"
                            Padding="16"
                            Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="Firmware file inspection"
                                       FontSize="17"
                                       FontWeight="SemiBold"/>

                            <TextBlock Text="Inspect a selected file's name, size and SHA-256 hash. Hashing alone does not establish authenticity or compatibility."
                                       Foreground="{DynamicResource Muted}"
                                       Margin="0,7,0,8"/>

                            <Button Content="Choose firmware file (.bin)"
                                    Click="InspectFirmware_Click"
                                    HorizontalAlignment="Left"/>

                            <Button Content="Flash MCU"
                                    IsEnabled="False"
                                    ToolTip="Unavailable until the flashing routine is connected."
                                    HorizontalAlignment="Left"
                                    Margin="0,8,0,0"/>

                            <TextBlock Text="Flashing is not connected yet."
                                       Foreground="{DynamicResource Warning}"
                                       Margin="0,4,0,0"/>
<TextBlock x:Name="FirmwareDetails"
                                       Text="No firmware file selected."
                                       Margin="0,8,0,0"
                                       LineHeight="22"/>
                        </StackPanel>
                    </Border>

                    <!-- Diagnostics -->
                    <Border Background="{DynamicResource Panel}"
                            CornerRadius="10"
                            Padding="16">
                        <StackPanel>
                            <TextBlock Text="Diagnostic output"
                                       FontSize="17"
                                       FontWeight="SemiBold"/>

                            <TextBlock Text="Activity and diagnostic messages from this application."
                                       Foreground="{DynamicResource Muted}"
                                       FontSize="12"
                                       Margin="0,5,0,0"/>

                            <TextBox x:Name="OutputLog"
                                     Margin="0,10,0,0"
                                     Height="160"
                                     IsReadOnly="True"
                                     AcceptsReturn="True"
                                     VerticalScrollBarVisibility="Auto"
                                     HorizontalScrollBarVisibility="Auto"
                                     TextWrapping="Wrap"
                                     Background="{DynamicResource InsetBackground}"
                                     Foreground="{DynamicResource LogForeground}"
                                     BorderThickness="0"
                                     Padding="10"/>

                            <Button Content="Open ASUS updater log"
                                    Click="OpenLog_Click"
                                    HorizontalAlignment="Left"
                                    Margin="0,10,0,0"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- Footer -->
        <DockPanel Grid.Row="2" Margin="0,15,0,0">
            <TextBlock Text="Vantara Labs | Diagnostic build"
                       Foreground="{DynamicResource Muted}"
                       VerticalAlignment="Center"/>

            <TextBlock Text="READ-ONLY MODE"
                       Foreground="{DynamicResource Accent}"
                       FontWeight="Bold"
                       DockPanel.Dock="Right"
                       HorizontalAlignment="Right"/>
        </DockPanel>
    </Grid>
</Window>


